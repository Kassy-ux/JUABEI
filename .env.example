# Nothing in this repo loads .env automatically — no lane depends on dotenv.
# Export these into your shell (e.g. `set -a; . ./.env; set +a`) before running.
#
# CAUTION: both services/ and ai-data/ read PORT. If you export one global PORT,
# the second service to start will try to bind a port that's already taken. Run
# each lane with its own PORT, e.g.:
#   cd services && PORT=4000 npm run dev
#   cd ai-data  && PORT=4100 npm run dev

# --- services/ — API Gateway, Valuation Service, Export Assessment Service ---
PORT=4000
# Where the Export Assessment Service reaches the AI Service (ai-data/).
AI_SERVICE_URL=http://localhost:4100

# --- ai-data/ — AI Service, Notification Service, PostgreSQL ---
# Defaults to 4100 when PORT is unset. Server-side only — never expose
# GEMINI_API_KEY to the PWA/USSD/WhatsApp clients.
GEMINI_API_KEY=
DATABASE_URL=postgres://user:password@localhost:5432/juabei
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
