# Copy this file to the ignored root .env.
# services/ and ai-data/ load it automatically; channels/ may require its
# variables to be supplied by its runtime.

# --- services/ — API Gateway, Valuation Service, Export Assessment Service ---
PORT=4000
AI_SERVICE_URL=http://localhost:4100

# --- channels/ — PWA server routes, USSD, and WhatsApp entry point ---
API_GATEWAY_URL=http://localhost:4000
# Required only by `npm run dev:ussd`. Find yours in the ngrok dashboard.
NGROK_AUTHTOKEN=
# Optional: a reserved ngrok domain for a stable callback URL.
NGROK_DOMAIN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Include the Graph API version configured for the Meta app, for example:
# https://graph.facebook.com/vXX.X
WHATSAPP_GRAPH_API_BASE_URL=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- ai-data/ — AI Service, Notification Service, PostgreSQL ---
AI_DATA_PORT=4100
DATABASE_URL=postgres://juabei:juabei@localhost:5432/juabei

# Required in production for all /ai, /data, and /notifications routes.
INTERNAL_API_TOKEN=

# Server-side only; never expose this to channels.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging
